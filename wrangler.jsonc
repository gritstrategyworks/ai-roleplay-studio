{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-roleplay-studio",
  "main": "src/index.js",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "BILLING_DB",
      "database_name": "ai-roleplay-billing",
      "database_id": "b4383f39-07b0-450b-9e3b-7ca40aa56c4b"
    }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "APP_URL": "https://roleplay.gritstrategyworks.com",
    "BILLING_ENABLED": "true",
    "DEVELOPER_EMAILS": "gritstrategyworks@gmail.com",
    "SIGNUP_ENABLED": "true",
    "STRIPE_PRICE_ID": "price_1U1JSkJYbwf4eLAfkVOYv6kq"
  }
}
